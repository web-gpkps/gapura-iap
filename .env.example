DATA_BACKEND=supabase
SUPABASE_URL=https://your_project_ref.supabase.co
# Server only. Also accepts sb_secret_...; never use NEXT_PUBLIC_ for this key.
SUPABASE_SERVICE_ROLE_KEY=
# Alternative: leave SERVICE_ROLE_KEY empty and use the scoped iap-data Edge gateway.
SUPABASE_IAP_SERVER_TOKEN=your_random_server_gateway_token
# Used for manually invoking the scheduled mirror; keep server-only.
IAP_SYNC_TOKEN=your_random_mirror_token
SHEETS_TRANSPORT=google
GOOGLE_SHEETS_SPREADSHEET_ID=your_spreadsheet_id
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n"
# Evidence remains in the folder owner's My Drive and uses owner OAuth credentials.
GOOGLE_DRIVE_EVIDENCE_FOLDER_ID=1uOd0jovHI70Ff5vQ-cjTu0QXLB4yZsV6
GOOGLE_DRIVE_OAUTH_CLIENT_ID=your_oauth_client_id.apps.googleusercontent.com
GOOGLE_DRIVE_OAUTH_CLIENT_SECRET=your_oauth_client_secret
GOOGLE_DRIVE_OAUTH_REFRESH_TOKEN=your_oauth_refresh_token

# Supabase — authentication, user approval and per-branch access.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
# Only for `npm run seed-demo-users`. The application itself never uses this key,
# so it does not belong in the Vercel environment.
SUPABASE_SERVICE_ROLE_KEY=

# Canonical deployed origin for auth callbacks; never derived from request headers.
APP_URL=https://your-app.vercel.app
# Local fixture tests only. Never enable on Vercel; remove Google credentials first.
ENABLE_OFFLINE_TEST_MODE=0

# Break-glass while Supabase is unreachable (blown quota, outage): the tracker is
# served straight from Google Sheets and nobody has to sign in. Requires
# DATA_BACKEND=memory with SHEETS_TRANSPORT=google. Per-branch access disappears
# with the accounts, so turn both back to 0 as soon as Supabase answers again.
IAP_OPEN_ACCESS=0
NEXT_PUBLIC_IAP_OPEN_ACCESS=0
